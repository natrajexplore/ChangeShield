rules_version = '2';
// ConfigShield: each user may only read/write their own SANITIZED audit reports.
// Raw configs and the token vault are never stored — the allowed key list enforces it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/audits/{auditId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'vendor', 'score', 'summary', 'findings', 'findingCount', 'auditSource',
             'redactionSource', 'tokensMasked', 'createdAt', 'schema'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.findings is list
        && request.resource.data.findings.size() <= 50
        && request.resource.data.summary is string
        && request.resource.data.summary.size() < 4000;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
